# Copy this file to .env and fill in your values
# cp .env.example .env

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=job_db

# Service URLs (used by api and worker containers)
DATABASE_URL=postgresql://postgres:your_password_here@postgres:5432/job_db
RABBITMQ_URL=amqp://guest:your_password_here@rabbitmq:5672/

# API Authentication — generate a strong key with: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=your_api_key_here
